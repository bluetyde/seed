{
  "name": "seed",
  "version": "0.0.0",
  "private": true,
  "description": "SEED, System for Engineering and Experimental Design: desktop host that opens the suite apps as tabs",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.cjs",
    "start": "npm run build && electron .",
    "test": "npm run build && vitest run",
    "seed:cli": "node dist/cli/seed.js",
    "seed:mcp": "node dist/mcp/seed.js",
    "test:e2:raft": "npm run build && node scripts/test-e2-raft.cjs",
    "test:launcher": "node --test scripts/test-windows-launcher.cjs",
    "e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "^8.20.0",
    "zod": "3.25.76"
  }
}
