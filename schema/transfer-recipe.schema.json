{
  "$id": "https://seed.invalid/schema/transfer-recipe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": { "const": "seed.transfer-recipe/0.2" },
    "recipeId": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
    "proposedBy": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/actor" },
    "proposedAt": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time" },
    "source": {
      "type": "object",
      "required": ["runId", "resultsSha256", "quantity", "dataSha256", "unit", "dimension", "normalization", "revisionPins"],
      "additionalProperties": false,
      "properties": {
        "runId": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "resultsSha256": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256" },
        "quantity": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dataSha256": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256" },
        "unit": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit" },
        "dimension": {
          "type": "string",
          "enum": ["length", "time", "temperature", "pressure", "energy", "power", "power-per-length", "power-per-volume", "heat-flux", "heat-transfer-coefficient", "mass-flow", "probability", "count", "rate", "dimensionless", "other"]
        },
        "normalization": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/normalization" },
        "revisionPins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact", "revision"],
            "additionalProperties": false,
            "properties": {
              "artifact": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
              "revision": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["app", "artifact", "revision", "field"],
      "additionalProperties": false,
      "properties": {
        "app": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "artifact": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
        "field": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" }
      }
    },
    "units": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": { "to": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit" } }
    },
    "normalization": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["none", "source-rate", "total-power"] },
        "value": {
          "type": "object",
          "required": ["value", "unit"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit" }
          }
        },
        "origin": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "mapping": {
      "type": "object",
      "required": ["spatial", "time", "extrapolation"],
      "additionalProperties": false,
      "properties": {
        "spatial": { "type": "object" },
        "time": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "type": "string", "enum": ["steady", "series"] }, "grid": { "type": "object" } }
        },
        "extrapolation": { "const": "refused" }
      }
    },
    "tolerance": {
      "type": "object",
      "required": ["conservation", "fixedBefore"],
      "additionalProperties": false,
      "properties": {
        "conservation": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "fixedBefore": { "const": "mapping" }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "range": { "type": "object" }, "note": { "type": "string", "maxLength": 1000 } }
    }
  },
  "required": ["schema", "recipeId", "proposedBy", "proposedAt", "source", "target", "units", "normalization", "mapping", "tolerance"],
  "additionalProperties": false
}
