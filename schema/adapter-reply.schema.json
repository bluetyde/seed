{
  "$id": "https://seed.invalid/schema/adapter-reply.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "seed.adapter-reply/0.1"
    },
    "verb": {
      "type": "string",
      "enum": [
        "describe",
        "open",
        "validate",
        "run",
        "status",
        "cancel",
        "collect"
      ]
    },
    "requestId": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
    },
    "ok": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/error"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^E_"
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/error"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^W_"
              }
            }
          }
        ]
      }
    },
    "result": {
      "type": "object"
    }
  },
  "required": ["schema", "verb", "requestId", "ok", "errors", "warnings"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object"
          },
          "errors": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": ["result"]
      },
      "else": {
        "properties": {
          "result": false,
          "errors": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "describe"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "app",
              "formats",
              "capabilities",
              "parameters",
              "quantities",
              "oracleCoverage"
            ],
            "additionalProperties": false,
            "properties": {
              "app": {
                "type": "object",
                "required": ["id", "name", "version"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              },
              "engine": {
                "type": "object",
                "required": ["name", "version"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  }
                }
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "version"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    }
                  }
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "type"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
                    },
                    "type": {
                      "type": "string",
                      "enum": ["number", "integer", "string", "boolean"]
                    },
                    "unit": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "enum": {
                      "type": "array"
                    }
                  }
                }
              },
              "quantities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "unit", "normalization"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "unit": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
                    },
                    "normalization": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/normalization"
                    }
                  }
                }
              },
              "oracleCoverage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["quantity", "domain"],
                  "additionalProperties": false,
                  "properties": {
                    "quantity": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "domain": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                }
              },
              "oraclePin": {
                "type": "object",
                "required": ["sha256", "commit"],
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
                  },
                  "commit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "open"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": ["editor"],
            "additionalProperties": false,
            "properties": {
              "editor": {
                "type": "string",
                "enum": ["opened", "focused"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "validate"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": ["valid", "problems"],
            "additionalProperties": false,
            "properties": {
              "valid": {
                "type": "boolean"
              },
              "problems": {
                "type": "array",
                "items": {
                  "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/error"
                }
              }
            },
            "if": {
              "properties": {
                "valid": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "problems": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "pattern": "^W_"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "run"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": ["jobId", "runDir", "lifecycle"],
            "additionalProperties": false,
            "properties": {
              "jobId": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "runDir": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/relPath"
              },
              "nativeProcesses": {
                "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                "items": { "type": "integer", "minimum": 2 }
              },
              "lifecycle": {
                "type": "string",
                "enum": ["queued", "running"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "status"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": ["jobId", "lifecycle", "native"],
            "additionalProperties": false,
            "properties": {
              "jobId": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "lifecycle": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/lifecycle"
              },
              "native": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/nativeStatus"
              },
              "startedAt": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
              },
              "finishedAt": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "cancel"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": ["jobId", "lifecycle", "cancelled"],
            "additionalProperties": false,
            "properties": {
              "jobId": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "lifecycle": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/lifecycle"
              },
              "cancelled": {
                "type": "boolean"
              },
              "nativeStopped": {
                "type": "boolean",
                "description": "Adapter confirms all owned native processes have stopped; optional recovery evidence."
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          },
          "verb": {
            "const": "collect"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "type": "object",
            "required": [
              "jobId",
              "lifecycle",
              "resultsIndex",
              "resultsSha256"
            ],
            "additionalProperties": false,
            "properties": {
              "jobId": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "lifecycle": {
                "type": "string",
                "const": "completed"
              },
              "resultsIndex": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/relPath"
              },
              "resultsSha256": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ]
}
