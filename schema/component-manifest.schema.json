{
  "$id": "https://seed.invalid/schema/component-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seed.component-manifest/0.1 (runtime contract, W2): what an app publishes about its installable components",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "app", "recipeRevision", "components"],
  "properties": {
    "schema": { "const": "seed.component-manifest/0.1" },
    "app": { "$ref": "#/$defs/id" },
    "recipeRevision": { "type": "string", "minLength": 1, "maxLength": 80 },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytes": { "type": "integer", "minimum": 0, "maximum": 4398046511104 },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "title", "platforms", "capabilities", "artifacts", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "kind": {
          "enum": ["core", "addon", "library"],
          "description": "core: always installed with the app. addon: the user may add or remove it. library: only a dependency of other components; never shown as a choice."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["os", "arch"],
            "properties": {
              "os": { "enum": ["windows", "macos", "linux"] },
              "arch": { "enum": ["x64", "arm64"] },
              "via": { "enum": ["native", "wsl"] }
            }
          }
        },
        "appVersions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min"],
          "properties": {
            "min": { "$ref": "#/$defs/version" },
            "max": { "$ref": "#/$defs/version" }
          }
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component"],
            "properties": {
              "component": { "$ref": "#/$defs/id" },
              "min": { "$ref": "#/$defs/version" }
            }
          }
        },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "artifacts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256", "downloadBytes", "expandedBytes", "archive"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "url": { "type": "string", "pattern": "^https://" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "downloadBytes": { "$ref": "#/$defs/bytes" },
              "expandedBytes": { "$ref": "#/$defs/bytes" },
              "archive": { "enum": ["zip", "tar.gz", "none"] }
            }
          }
        },
        "dataRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sha256"],
            "properties": { "id": { "$ref": "#/$defs/id" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1, "maxLength": 80 },
            "noticesSha256": { "$ref": "#/$defs/sha256" },
            "sourceOffer": { "type": "boolean" }
          }
        }
      }
    }
  }
}
