{
  "$id": "https://seed.invalid/schema/transfer-host.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "seed.transfer-host/0.1" },
    "projectRoot": { "type": "string", "minLength": 1 },
    "stateRoot": { "type": "string", "minLength": 1 },
    "actor": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/actor" },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": ["studyId", "tier", "budget", "parameters"],
      "properties": {
        "studyId": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "tier": { "enum": ["A0", "A1", "A2", "A3"] },
        "budget": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/budget" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "min", "max"],
            "properties": {
              "id": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "unit": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit" }
            }
          }
        }
      }
    },
    "transfersFolder": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/relPath" },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter", "oracles", "acceptedPins"],
        "properties": {
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
              "version": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          },
          "oracles": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "entriesDir", "inputsRoot", "evidenceFile", "evidenceSha256"],
            "properties": {
              "repository": { "type": "string", "minLength": 1 },
              "entriesDir": { "type": "string", "minLength": 1 },
              "inputsRoot": { "type": "string", "minLength": 1 },
              "evidenceFile": { "type": "string", "minLength": 1 },
              "evidenceSha256": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256" }
            }
          },
          "acceptedPins": {
            "type": "object",
            "additionalProperties": false,
            "required": ["appCommit", "oracleFiles"],
            "properties": {
              "appCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "oracleFiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["oracleId", "entryVersion", "sha256"],
                  "properties": {
                    "oracleId": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
                    "entryVersion": { "type": "integer", "minimum": 1 },
                    "sha256": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256" }
                  }
                }
              }
            }
          },
          "transfer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "args", "fields"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "args": { "type": "array", "items": { "type": "string" } },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["field", "accepts"],
                  "properties": {
                    "field": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
                    "accepts": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["dimension"],
                        "properties": {
                          "dimension": { "type": "string", "minLength": 1, "maxLength": 40 },
                          "additional": {
                            "type": "array",
                            "maxItems": 4,
                            "items": {
                              "type": "object",
                              "required": ["role", "dimension"],
                              "additionalProperties": false,
                              "properties": {
                                "role": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
                                "dimension": { "type": "string", "minLength": 1, "maxLength": 40 }
                              }
                            }
                          },
                          "normalization": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/normalization" }
                        }
                      }
                    }
                  }
                }
              },
              "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
            }
          }
        }
      }
    }
  },
  "required": ["schema", "projectRoot", "stateRoot", "actor", "study", "apps"]
}
