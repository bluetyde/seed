{
  "$id": "https://seed.invalid/schema/process-owner.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seed.process-owner/0.1 (runtime contract, W2): one ownership record per app launch or job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "launchId", "kind", "runtime", "supervisor", "host", "generation", "state", "startedAt"],
  "properties": {
    "schema": { "const": "seed.process-owner/0.1" },
    "launchId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "kind": { "enum": ["launch", "job"] },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "version"],
      "properties": {
        "component": { "$ref": "component-manifest.schema.json#/$defs/id" },
        "version": { "$ref": "component-manifest.schema.json#/$defs/version" }
      }
    },
    "supervisor": { "enum": ["seed", "standalone"] },
    "host": { "$ref": "#/$defs/identity" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["via", "identity"],
      "properties": {
        "via": { "enum": ["native", "wsl"] },
        "distro": { "type": "string", "minLength": 1, "maxLength": 80 },
        "identity": { "$ref": "#/$defs/identity" }
      },
      "allOf": [{ "if": { "properties": { "via": { "const": "wsl" } } }, "then": { "required": ["distro"], "properties": { "distro": true } } }]
    },
    "endpoint": { "type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]{2,5}(/.*)?$" },
    "generation": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "state": { "enum": ["starting", "running", "stopping", "stopped", "orphaned"] },
    "startedAt": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "startIdentity"],
      "description": "A process is named by its pid AND the time it started (Windows creation time; Linux boot id and /proc/<pid>/stat start time), because a pid alone can be reused.",
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "startIdentity": { "type": "string", "minLength": 1, "maxLength": 200 },
        "host": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
