{
  "$id": "https://seed.invalid/schema/transfer-recipe-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "recipeId", "proposedBy", "proposedAt", "source", "target", "units"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "seed.transfer-recipe/0.3" },
    "recipeId": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
    "proposedBy": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/actor" },
    "proposedAt": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time" },
    "source": {
      "type": "object",
      "required": ["kind", "record", "artifact", "recordSha256", "recordId", "region", "time", "revisionPins"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "record" },
        "record": { "const": "depletion-record/1" },
        "artifact": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "recordSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recordId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "region": { "type": "string", "minLength": 1, "maxLength": 200 },
        "time": { "type": "number", "minimum": 0 },
        "revisionPins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["artifact", "revision"],
            "additionalProperties": false,
            "properties": {
              "artifact": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
              "revision": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["app", "artifact", "revision", "field"],
      "additionalProperties": false,
      "properties": {
        "app": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "artifact": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" },
        "revision": { "type": "string", "minLength": 1, "maxLength": 80 },
        "field": { "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id" }
      }
    },
    "units": {
      "type": "object",
      "required": ["field", "from", "to", "factor", "basis"],
      "additionalProperties": false,
      "properties": {
        "field": { "const": "burnup_mwd_per_tu" },
        "from": { "const": "MWd/tU" },
        "to": { "const": "MWd/kgHM" },
        "factor": { "type": "number", "exclusiveMinimum": 0 },
        "basis": { "const": "heavy-metal" }
      }
    }
  }
}
