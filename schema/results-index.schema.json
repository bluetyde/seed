{
  "$id": "https://seed.invalid/schema/results-index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "seed.results-index/0.1"
    },
    "runId": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
    },
    "status": {
      "type": "string",
      "const": "completed"
    },
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "inputHashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/inputRef"
      }
    },
    "nativeStatus": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/nativeStatus"
    },
    "quantities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "normalization",
          "provenance",
          "data",
          "verification"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
          },
          "normalization": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/normalization"
          },
          "provenance": {
            "type": "object",
            "required": ["runId", "inputRevisions"],
            "additionalProperties": false,
            "properties": {
              "runId": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "inputRevisions": {
                "type": "array",
                "items": {
                  "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
                }
              },
              "mappingRecipe": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              }
            }
          },
          "data": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/inputRef"
          },
          "verification": {
            "type": "string",
            "enum": ["verified", "unverified"]
          },
          "coordinates": {
            "type": "object",
            "required": ["system", "axes"],
            "additionalProperties": false,
            "properties": {
              "system": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "axes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "unit"],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "unit": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
                    }
                  }
                }
              }
            }
          },
          "timeGrid": {
            "type": "object",
            "required": ["unit", "start", "stop", "count"],
            "additionalProperties": false,
            "properties": {
              "unit": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
              },
              "start": {
                "type": "number"
              },
              "stop": {
                "type": "number"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "uncertainty": {
            "type": "object",
            "required": ["kind", "value"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["statistical", "input", "model"]
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
              }
            }
          }
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "oracle": {
      "type": "object",
      "required": ["entries", "verdict"],
      "additionalProperties": false,
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
          }
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail", "not-run"]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "runId",
    "status",
    "adapter",
    "engine",
    "inputHashes",
    "nativeStatus",
    "quantities"
  ],
  "additionalProperties": false
}
