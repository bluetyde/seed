{
  "$id": "https://seed.invalid/schema/run-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "seed.run-record/0.1"
    },
    "runId": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "state": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/lifecycle"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/inputRef"
      }
    },
    "settings": {
      "type": "object"
    },
    "budget": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/budget"
    },
    "createdAt": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
    },
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "dataLibrary": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
        },
        "hash": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
        }
      }
    },
    "jobId": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
    },
    "native": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/nativeStatus"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "budgetUsed": {
      "type": "object",
      "required": ["wallSeconds", "cores", "memoryMB", "diskMB"],
      "additionalProperties": false,
      "properties": {
        "wallSeconds": {
          "type": "number",
          "minimum": 0
        },
        "cores": {
          "type": "number",
          "minimum": 0
        },
        "memoryMB": {
          "type": "number",
          "minimum": 0
        },
        "diskMB": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "startedAt": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
    },
    "finishedAt": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
    },
    "cacheKey": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/inputRef"
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "runId",
    "attempt",
    "adapter",
    "state",
    "inputs",
    "settings",
    "budget",
    "createdAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "finishedAt": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/inputRef"
            }
          }
        },
        "required": ["finishedAt", "outputs"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "cancelled",
              "interrupted",
              "terminated-by-trip"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "finishedAt": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
          }
        },
        "required": ["finishedAt"]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        }
      },
      "then": {
        "properties": {
          "finishedAt": false
        }
      }
    }
  ]
}
