{
  "$id": "https://seed.invalid/schema/coupling-host.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "seed.coupling-host/0.1"
    },
    "projectRoot": {
      "type": "string",
      "minLength": 1
    },
    "stateRoot": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/actor"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "studyId",
        "tier",
        "budget",
        "parameters"
      ],
      "properties": {
        "studyId": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
        },
        "tier": {
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3"
          ]
        },
        "budget": {
          "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/studyBudget"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "min",
              "max"
            ],
            "properties": {
              "id": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "unit": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/unit"
              }
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "oracles",
          "acceptedPins"
        ],
        "properties": {
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          },
          "oracles": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "entriesDir",
              "inputsRoot",
              "evidenceFile",
              "evidenceSha256"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "entriesDir": {
                "type": "string",
                "minLength": 1
              },
              "inputsRoot": {
                "type": "string",
                "minLength": 1
              },
              "evidenceFile": {
                "type": "string",
                "minLength": 1
              },
              "evidenceSha256": {
                "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
              }
            }
          },
          "acceptedPins": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "appCommit",
              "oracleFiles"
            ],
            "properties": {
              "appCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "oracleFiles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "oracleId",
                    "entryVersion",
                    "sha256"
                  ],
                  "properties": {
                    "oracleId": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
                    },
                    "entryVersion": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "grantId": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
          },
          "studyId": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
          },
          "actor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "human",
                  "agent",
                  "system"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "name"
            ]
          },
          "operation": {
            "type": "string"
          },
          "inputRevisions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
                }
              },
              "required": [
                "artifact",
                "revision"
              ]
            }
          },
          "issuedAt": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
          },
          "expires": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/time"
          },
          "revoked": {
            "type": "boolean"
          },
          "approvedBy": {
            "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/actor"
          }
        },
        "required": [
          "grantId",
          "studyId",
          "actor",
          "operation",
          "inputRevisions",
          "issuedAt",
          "expires",
          "approvedBy"
        ]
      }
    },
    "loops": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "kind",
          "apps",
          "inputs",
          "definition",
          "start"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "plumbing-test",
              "physics"
            ]
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "apps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
            }
          },
          "inputs": {
            "type": "object",
            "minProperties": 2,
            "maxProperties": 4,
            "propertyNames": {
              "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/id"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "artifact",
                  "revision"
                ],
                "properties": {
                  "artifact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "$ref": "https://seed.invalid/schema/common.schema.json#/$defs/sha256"
                  }
                }
              }
            }
          },
          "definition": {
            "type": "object"
          },
          "start": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "projectRoot",
    "stateRoot",
    "actor",
    "study",
    "apps",
    "loops"
  ]
}
